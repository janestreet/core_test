opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/core_test"
bug-reports: "https://github.com/janestreet/core_test/issues"
dev-repo: "git+https://github.com/janestreet/core_test.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/core_test/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: [
  ["dune" "runtest" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.1.0"}
  "base_quickcheck"
  "base_test"
  "core"
  "core_kernel"
  "expect_test_helpers_base"
  "expect_test_helpers_core"
  "expectable"
  "patdiff"
  "ppx_bin_and_sexp_digest"
  "ppx_jane"
  "ppx_quick_test"
  "sexp_grammar"
  "sexplib"
  "dune"                     {>= "3.17.0"}
]
available: arch != "x86_32"
synopsis: "Tests for Core"
description: "
Part of Jane Street's Core library
Tests for the Core library.
"
